# mount point   fstype   device                                   flags

/system         erofs    system                                   flags=display="System";logical;slotselect
/vendor         erofs    vendor                                   flags=display="Vendor";logical;slotselect
/product        erofs    product                                  flags=display="Product";logical;slotselect
/system_ext     erofs    system_ext                               flags=display="System_ext";logical;slotselect
/odm            erofs    odm                                      flags=display="ODM";logical;slotselect
/vendor_dlkm    erofs    vendor_dlkm                              flags=display="Vendor_dlkm";logical;slotselect
/system_dlkm    erofs    system_dlkm                              flags=display="System_dlkm";logical;slotselect

/data           f2fs     /dev/block/by-name/userdata              flags=display="Data";backup=1
/metadata       f2fs     /dev/block/by-name/metadata              flags=display="Metadata"
/cache          ext4     /dev/block/by-name/cache                 flags=display="Cache"
/misc           emmc     /dev/block/by-name/misc
/efs            ext4     /dev/block/by-name/efs                   flags=display="EFS";backup=1
/cpefs          ext4     /dev/block/by-name/cpefs                 flags=display="CPEFS"
/prism          ext4     /dev/block/by-name/prism                 flags=display="Prism";slotselect
/optics         ext4     /dev/block/by-name/optics                flags=display="Optics";slotselect

/boot           emmc     /dev/block/by-name/boot                  flags=display="Boot";backup=1;flashimg=1;slotselect
/init_boot      emmc     /dev/block/by-name/init_boot             flags=display="Init_boot";backup=1;flashimg=1;slotselect
/vendor_boot    emmc     /dev/block/by-name/vendor_boot           flags=display="Vendor_boot";backup=1;flashimg=1;slotselect
/dtbo           emmc     /dev/block/by-name/dtbo                  flags=display="DTBO";backup=1;flashimg=1;slotselect
/vbmeta         emmc     /dev/block/by-name/vbmeta                flags=display="VBMeta";backup=1;flashimg=1;slotselect
/vbmeta_system  emmc     /dev/block/by-name/vbmeta_system         flags=display="VBMeta_system";backup=1;flashimg=1;slotselect

/external_sd    auto     /dev/block/mmcblk1p1                     flags=display="MicroSD";storage;wipeingui;removable
#/usb_otg        auto     /dev/block/sda1                          flags=display="USB OTG";storage;wipeingui;removable
